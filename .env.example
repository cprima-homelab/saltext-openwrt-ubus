# Salt extension development environment variables
# Copy this file to .env and adjust as needed.
# These are read by noxfile.py during test/lint sessions.

# Skip reinstalling dependencies on subsequent test runs (speeds up iteration)
# SKIP_REQUIREMENTS_INSTALL=1

# Install extra packages into test sessions (e.g. debugger)
# EXTRA_REQUIREMENTS_INSTALL=ipdb

# Use ipdb as the breakpoint() debugger
# PYTHONBREAKPOINT=ipdb.set_trace

# Pin a specific Salt version for testing (default: salt>=3006)
# SALT_REQUIREMENT=salt==3006.10

# Pin a specific coverage version (default: coverage==7.13.4)
# COVERAGE_REQUIREMENT=coverage==7.13.4

# Write pylint report to a file
# PYLINT_REPORT=artifacts/pylint-report.txt
