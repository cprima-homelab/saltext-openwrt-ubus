# Salt extension environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Integration test: Docker container (openwrt rootfs) ---
# Defaults apply when unset: UBUS_HOST=localhost UBUS_PORT=7080 SALT_AGENT_PASSWORD=test1234

# --- Integration test: live device(s) ---
# Up to 3 device slots, addressed generically (not by codename) since the
# physical device behind a slot can change over time. A slot with no HOST
# set is simply absent — the live suite skips cleanly when none are set.
# LIVE_DEVICE_1_HOST=                    # required: IP or hostname
# LIVE_DEVICE_1_PORT=80                  # optional: HTTP port (default 80)
# LIVE_DEVICE_1_SALT_AGENT_PASSWORD=      # required: salt-agent rpcd password
# LIVE_DEVICE_1_ROOT_PASSWORD=            # optional: root SSH password (SSH tests skip if absent)
# LIVE_DEVICE_1_SSH_PORT=22               # optional: SSH port (default 22)
# LIVE_DEVICE_2_HOST=
# LIVE_DEVICE_2_PORT=80
# LIVE_DEVICE_2_SALT_AGENT_PASSWORD=
# LIVE_DEVICE_2_ROOT_PASSWORD=
# LIVE_DEVICE_2_SSH_PORT=22
# LIVE_DEVICE_3_HOST=
# LIVE_DEVICE_3_PORT=80
# LIVE_DEVICE_3_SALT_AGENT_PASSWORD=
# LIVE_DEVICE_3_ROOT_PASSWORD=
# LIVE_DEVICE_3_SSH_PORT=22

# --- Salt nox development (optional) ---
# SKIP_REQUIREMENTS_INSTALL=1
# EXTRA_REQUIREMENTS_INSTALL=ipdb
# PYTHONBREAKPOINT=ipdb.set_trace
# SALT_REQUIREMENT=salt==3006.10
# COVERAGE_REQUIREMENT=coverage==7.13.4
# PYLINT_REPORT=artifacts/pylint-report.txt
