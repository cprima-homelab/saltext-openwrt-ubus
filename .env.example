# Salt extension environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Device: <wind-name> (e.g. austru) ---
# AUSTRU_HOST=10.35.24.1
# AUSTRU_USER=salt-agent
# AUSTRU_PASSWORD=

# --- Device: GL-MT3000 (pending wind name) ---
# GLMT3000_HOST=10.22.2.1
# GLMT3000_ROOT_PASSWORD=      # used during initial salt-agent setup only; not needed afterwards

# --- Integration test: Docker container (openwrt rootfs) ---
# Defaults apply when unset: UBUS_HOST=localhost UBUS_PORT=7080 SALT_AGENT_PASSWORD=test1234

# --- Integration test: live device ---
# LIVE_HOST=               # required: IP or hostname of the target device
# LIVE_PORT=80             # optional: HTTP port (default 80)
# LIVE_SALT_AGENT_PASSWORD=  # required: salt-agent rpcd password
# LIVE_ROOT_PASSWORD=        # optional: root SSH password (SSH tests skip if absent)
# LIVE_SSH_PORT=22           # optional: SSH port (default 22)

# --- Salt nox development (optional) ---
# SKIP_REQUIREMENTS_INSTALL=1
# EXTRA_REQUIREMENTS_INSTALL=ipdb
# PYTHONBREAKPOINT=ipdb.set_trace
# SALT_REQUIREMENT=salt==3006.10
# COVERAGE_REQUIREMENT=coverage==7.13.4
# PYLINT_REPORT=artifacts/pylint-report.txt
